# QB Connector local env (loaded by python-dotenv)
QB_USERNAME=qbuser
QB_PASSWORD=admin123
OMS_BASE_URL=https://oms.kitchen365test.com
OMS_ACCESS_TOKEN=tqe1crbqwqdqlxocd9j07d1x2etbat08
OMS_PAGE_SIZE=100
# Jobs sent to QuickBooks Web Connector per login (was hardcoded 5)
QBWC_JOB_BATCH_SIZE=100
OMS_REQUEST_TIMEOUT=30
OMS_ORDER_STATUS=complete
# Phase-1 test mode: set specific entity_id (example: 1188); keep empty for full sync
OMS_ORDER_TEST_ENTITY_ID=
OMS_ORDER_SYNC_ON_AUTH=1
LOG_LEVEL=INFO
OMS_ORDER_SORT_FIELD=entity_id
OMS_ORDER_SORT_DIRECTION=DESC
OMS_INVENTORY_SOURCE_CODE=default
OMS_INVENTORY_STATUS=1
OMS_INVENTORY_BATCH_SIZE=100
OMS_INVENTORY_PUSH_ENABLED=1
# Persisted Magento entity_id -> QB TxnID (survives restarts)
QB_ORDER_SYNC_STATE_FILE=logs/qb_order_sync_state.json
QB_ORDER_ID_SOURCE=entity
QB_SALES_ORDER_ORDER_ID_DATAEXT_NAME=Order Id
# Optional comma-separated aliases for DataExtName matching (e.g. ORDER ID,Order Id)
# QB_SO_CUSTOM_FIELD_ALIASES=
QB_SO_DEDUP_QUERY=1
QB_SO_QUERY_DATE_WINDOW_DAYS=90
QB_SO_QUERY_MAX_RETURNED=100
